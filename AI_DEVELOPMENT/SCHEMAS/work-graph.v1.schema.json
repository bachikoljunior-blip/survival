{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical work graph",
  "version": 1,
  "description": "AI_DEVELOPMENT/WORK_GRAPH.yaml — the single hierarchy and dependency graph. The legacy design kept PLAN/TASK/FRONTIER as three authorities that could disagree; here the frontier is derived and cached in STATE.yaml instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state_revision", "nodes"],
  "properties": {
    "schema_version": { "const": 1 },
    "state_revision": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$" },
    "notes": { "type": "string" },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/node" } }
  },
  "definitions": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "parent", "title", "status", "dependencies", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
        "kind": { "enum": ["project", "outcome", "workstream", "system", "task"] },
        "parent": { "type": "string", "nullable": true },
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "proposed", "accepted", "ready", "active", "blocked", "awaiting_verification",
            "under_review", "verified", "partial_verified", "rejected", "deferred",
            "superseded", "archived"
          ]
        },
        "status_note": { "type": "string" },
        "priority_class": { "enum": ["P0", "P1", "P2", "P3", "P4", "P5"] },
        "priority_rationale": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "acceptance_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "requirement_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "archive_refs": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 1 },
        "contract": { "$ref": "#/definitions/contract" },
        "notes": { "type": "string" }
      }
    },

    "contract": {
      "type": "object",
      "description": "Required on every leaf whose status is active, ready or blocked. A leaf without a contract is not eligible for selection.",
      "additionalProperties": false,
      "required": [
        "objective",
        "allowed_scope",
        "prohibited_changes",
        "expected_outputs",
        "verification",
        "evidence_required",
        "rollback",
        "completion_conditions"
      ],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "allowed_scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "prohibited_changes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "affected_systems": { "type": "array", "items": { "type": "string" } },
        "invariants": { "type": "array", "items": { "type": "string" } },
        "required_inputs": { "type": "array", "items": { "type": "string" } },
        "expected_outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "uncertainty": { "type": "string" },
        "risks": { "type": "array", "items": { "type": "string" } },
        "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "mandatory_gates": { "type": "array", "items": { "type": "string" } },
        "evidence_required": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "active_modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module", "activation_reason", "exit_condition"],
            "properties": {
              "module": { "type": "string" },
              "activation_reason": { "type": "string" },
              "budget": { "type": "string" },
              "exit_condition": { "type": "string" }
            }
          }
        },
        "owner": { "type": "string" },
        "specialists": { "type": "array", "items": { "type": "string" } },
        "integration_owner": { "type": "string" },
        "independence_level": { "enum": ["A", "B", "C", "D"] },
        "rollback": { "type": "string", "minLength": 1 },
        "completion_conditions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
