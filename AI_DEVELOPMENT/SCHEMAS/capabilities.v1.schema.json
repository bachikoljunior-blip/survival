{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-run capability record",
  "version": 1,
  "description": "AI_DEVELOPMENT/CAPABILITIES.yaml — what was actually observed in one Claude Code run. Capabilities and GitHub state change between runs, so this record is re-probed each run rather than trusted from the last one. Every entry needs evidence: 'assumed available' is not a capability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state_revision", "run_id", "observed_at", "capabilities"],
  "properties": {
    "schema_version": { "const": 1 },
    "state_revision": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": { "type": ["string", "boolean", "number", "null"] }
    },
    "notes": { "type": "string" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state", "evidence", "confidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "state": { "enum": ["available", "unavailable", "partial", "not_probed"] },
          "evidence": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["high", "medium", "low"] },
          "limitations": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
