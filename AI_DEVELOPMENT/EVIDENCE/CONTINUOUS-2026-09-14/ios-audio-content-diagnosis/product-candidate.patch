+  /** Interior audio follows the same authored space as the visual mood. */
+  _syncAmbience(region = this.game.zone) {
+    const interiorId = this.game.director?.currentInterior || null;
+    if (region === this._ambienceRegion && interiorId === this._ambienceInterior) return;
+    this._ambienceRegion = region;
+    this._ambienceInterior = interiorId;
+    const interior = interiorId ? this.game.city?.interiors?.get(interiorId) : null;
+    this.setAmbience(interiorId
+      ? (interior?.mood === 'under' ? 'under' : 'interior')
+      : (region?.ambience || 'street'));
+  }
