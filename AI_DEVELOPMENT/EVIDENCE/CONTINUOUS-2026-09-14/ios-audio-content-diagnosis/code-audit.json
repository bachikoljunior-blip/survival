      "excerpt": "  regionAt(x, z) {\n    for (const r of this.regions) {\n      if (x >= r.x - r.w / 2 && x <= r.x + r.w / 2 && z >= r.z - r.d / 2 && z <= r.z + r.d / 2) return r;\n    }\n    return null;\n  }"
