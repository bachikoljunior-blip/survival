    "",
    "  prepare-narrative-product:",
    "    name: Prepare exact reviewed narrative source and root",
    "    if: github.event_name == 'push' && github.run_attempt == 1 && contains(github.event.head_commit.message, '[prepare-narrative-product-r1]')",
    "    runs-on: ubuntu-latest",
    "    timeout-minutes: 15",
    "    permissions:",
    "      contents: read",
    "    steps:",
    "      - uses: actions/checkout@v4",
    "        with:",
    "          fetch-depth: 0",
    "          persist-credentials: false",
    "      - uses: actions/setup-node@v4",
    "        with:",
    "          node-version: '20'",
    "          cache: npm",
    "      - run: npm ci",
    "      - run: node --check tools/prepare-narrative-product.mjs",
    "      - name: Reproduce the original build and prepare the exact candidate bytes",
    "        run: node tools/prepare-narrative-product.mjs",
    "      - name: Export complete prepared files with hashes and offsets",
    "        run: node tools/prepare-narrative-product.mjs --export",
    "      - name: Preserve original candidate or failure report",
    "        if: always()",
    "        uses: actions/upload-artifact@v4",
    "        with:",
    "          name: narrative-product-build-r1-${{ github.sha }}",
    "          path: test-results/narrative-product-build-r1",
    "          if-no-files-found: error",
    "          retention-days: 14"
