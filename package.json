{
  "name": "cinderline",
  "version": "1.0.0",
  "description": "CINDERLINE — a survival action RPG in a city built over a fire that will not go out.",
  "main": "src/main.js",
  "scripts": {
    "build": "node build.mjs",
    "build:pages-root": "node build.mjs && node tools/export_pages_root.mjs",
    "dev": "node build.mjs --serve",
    "watch": "node build.mjs --watch",
    "validate:ops": "node tools/check_operating_state.mjs",
    "test:save": "node build.mjs --dev && node tools/save_migration.mjs",
    "check:kit": "node .kit/tools/bootstrap.mjs --target=. --check",
    "validate:pages-root": "node tools/export_pages_root.mjs --check",
    "validate": "node tools/validate.mjs",
    "validate:benchmarks": "node tools/check_benchmarks.mjs",
    "bench": "node build.mjs && node tools/perf.mjs && node tools/bench_measure.mjs && node tools/check_benchmarks.mjs",
    "test": "node tools/check_operating_state.mjs && node build.mjs --dev && node tools/validate.mjs && node tools/check_benchmarks.mjs && node tools/gate_b_adversarial.mjs && node tools/gate_b_slice.mjs && node tools/playthrough.mjs && node tools/perf.mjs && npm run test:save && npm run test:faults && npm run test:touch",
    "test:faults": "node build.mjs && node tools/fault_recovery.mjs",
    "test:touch": "node build.mjs && node tools/touch_smoke.mjs",
    "test:iphone-webkit": "node build.mjs && node tools/test-iphone-webkit.mjs",
    "test:ios-safari": "node build.mjs && node tools/test-ios-safari.mjs",
    "gates": "node tools/gates/f2_state_update.mjs --base origin/main && node tools/gates/f3_execution.mjs",
    "test:content": "node tools/validate.mjs",
    "test:play": "node build.mjs --dev && node tools/playthrough.mjs",
    "test:gate-b": "node build.mjs --dev && node tools/gate_b_adversarial.mjs && node tools/gate_b_slice.mjs",
    "test:gate-b:clean": "node build.mjs --dev && node tools/gate_b_slice.mjs",
    "test:perf": "node build.mjs && node tools/perf.mjs",
    "shots": "node build.mjs --dev && node tools/vantage.mjs",
    "i18n": "node tools/i18n_report.mjs ja && node tools/i18n_glossary.mjs ja",
    "test:play:ja": "node build.mjs --dev && node tools/playthrough.mjs --lang ja"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:41729/git/bachikoljunior-blip/survival"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0"
  },
  "type": "module",
  "private": true
}
